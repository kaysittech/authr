rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit public read access for Under Construction site status configuration
    match /public_status/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /system_config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // General collection access
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
